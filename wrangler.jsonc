{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "novel-chart-builder",
  "main": "src/worker.ts",
  "compatibility_date": "2026-03-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "novel-chart-builder-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}
