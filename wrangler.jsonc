{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "novel-chart-builder",
	"main": "src/worker.ts",
	"compatibility_date": "2026-03-01",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "novel_chart_builder_db",
			"database_name": "novel-chart-builder-db",
			"database_id": "c8e2e468-a70b-4957-b06e-819e453c6caf"
		}
	]
	// ※ メールアドレスなどの機密情報はリポジトリに含めず、以下のいずれかで設定してください：
	// 1. Cloudflare Zero Trust (Access) のダッシュボード上で許可メールアドレスのポリシーを設定
	// 2. Worker側でも検証する場合は Secret として登録: `bun x wrangler secret put ALLOWED_EMAILS`
}
